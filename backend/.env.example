# Copy this file to .env before running the backend:  cp .env.example .env

# Port the API server listens on
PORT=4000

# Secret used to sign JWT tokens. Use a long random value in a real deployment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# SQLite database file (relative to the backend folder)
DATABASE_FILE=database/maintenance.db

# Uploaded request photos (relative to the backend folder)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# Origin allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Prototype rule: student email addresses must end in this domain
STUDENT_EMAIL_DOMAIN=ufh.ac.za
