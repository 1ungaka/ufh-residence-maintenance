# Optional. Copy this file to .env (same folder) to use a different Supabase
# project. Without a .env file the app connects to the team's shared project.
# Find these in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
